# Paperclip (https://paperclip.gxl.ai/keys) — used for all evidence retrieval.
PAPERCLIP_API_KEY=gxl_...
PAPERCLIP_MCP_URL=https://paperclip.gxl.ai/mcp

# Anthropic (https://platform.claude.com) — used for extraction + FDA-approver scoring.
ANTHROPIC_API_KEY=sk-ant-...
# Opus 5 is the default for the higher-judgment production review.
# Use claude-haiku-4-5-20251001 for faster, lower-cost workflow testing.
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth for the review pass: low | medium | high | xhigh | max.
# It applies to models that support effort (for example, Opus), not Haiku.
EVAL_EFFORT=high

# Reasoning depth for catalog extraction (mechanical work — keep this cheap).
EXTRACT_EFFORT=low

# Bounded parallelism for independent Paperclip calls and CLARITY domain passes.
PAPERCLIP_CONCURRENCY=4
DOMAIN_CONCURRENCY=2

# off | metadata | full. The UI checkbox can request a one-off full trace.
# Full traces retain public evidence, prompts, structured model outputs, timing, and usage locally.
TRACE_MODE=off

# --- Modal (optional second compute provider) -------------------------------
# Claude does the reading and the judgement. Modal carries the two jobs that
# want a GPU: folding a real sequence into a structure, and grounding a claim to
# the exact passage that supports it. Both surfaces are inert without these.
#
# The endpoint URL: https://<workspace>--<app>-<fn>.modal.run for a deployed web
# function, or https://<endpoint>.<region>.modal.direct for an Auto Endpoint.
MODAL_ENDPOINT_URL=
# Proxy-auth token pair. The id is wk-..., the secret ws-... — the secret is
# shown once at creation. Keep both out of the repository; on Vercel set them as
# project environment variables.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# json    = POST the task payload as-is (a hand-written Modal web function)
# openai  = wrap it as a chat completion (Modal's OpenAI-compatible endpoints)
MODAL_MODE=json
MODAL_MODEL=
MODAL_TIMEOUT_MS=120000

# --- run guards ------------------------------------------------------------
# The two routes that start a review spend Anthropic and Paperclip tokens, and
# they sit on a public URL with no authentication. These bound the exposure.
#
# off = serve cached reviews only. The right setting for a public demo link.
PUBLIC_RUNS=on
# Review starts allowed from one address per window, and the window in ms.
RUN_LIMIT=6
RUN_WINDOW_MS=600000
# Reviews allowed to run at the same time across this instance.
RUN_CONCURRENCY=2

PORT=3000
# Bind address. 0.0.0.0 exposes the app on your network; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Optional: alternate data location. Useful for isolated test runs.
# DATA_DIR=/tmp/fdaapproval-data
