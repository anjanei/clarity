# Paperclip (https://paperclip.gxl.ai/keys) — used for all evidence retrieval.
PAPERCLIP_API_KEY=gxl_...
PAPERCLIP_MCP_URL=https://paperclip.gxl.ai/mcp

# Model provider — used for extraction + FDA-approver scoring.
# Default is Anthropic for the judgment-heavy production review.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-5
MODEL_API_KEY=sk-ant-...
# For OpenAI or OpenAI-compatible endpoints:
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-5
# MODEL_API_KEY=sk-...
# MODEL_BASE_URL=https://api.openai.com/v1

# Backwards-compatible Anthropic/OpenAI aliases also work.
ANTHROPIC_API_KEY=sk-ant-...
# Opus 5 is the default for the higher-judgment production review.
# Use claude-haiku-4-5-20251001 for faster, lower-cost workflow testing.
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Reasoning depth for the review pass: low | medium | high | xhigh | max.
# It applies to models that support effort (for example, Opus), not Haiku.
EVAL_EFFORT=high

# Reasoning depth for catalog extraction (mechanical work — keep this cheap).
EXTRACT_EFFORT=low

# Bounded parallelism for independent Paperclip calls and CLARITY domain passes.
PAPERCLIP_CONCURRENCY=4
DOMAIN_CONCURRENCY=2

# off | metadata | full. The UI checkbox can request a one-off full trace.
# Full traces retain public evidence, prompts, structured model outputs, timing, and usage locally.
TRACE_MODE=off

# Persistent run memory. With MONGODB_URI set, every audit record is stored in
# MongoDB; without it, local development uses DATA_DIR/audits.
AUDIT_STORE=filesystem
# AUDIT_STORE=mongodb
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=fdaapproval
MONGODB_AUDITS_COLLECTION=evaluation_audits

# --- Modal (optional second compute provider) -------------------------------
# The configured model does the reading and the judgement. Modal carries the two jobs that
# want a GPU: folding a real sequence into a structure, and grounding a claim to
# the exact passage that supports it. Both surfaces are inert without these.
#
# Grounding wants a language model; folding wants a structure predictor. They are
# almost never the same deployment, so each has its own endpoint and protocol,
# both falling back to MODAL_ENDPOINT_URL when one deployment really serves both.
#
# Modal web functions: https://<workspace>--<app>-<fn>.modal.run
# Shared Endpoints:    https://inference.us-west.modal.direct
# Endpoint model ids:  <endpoint-name>.us-west.modal.direct
MODAL_ENDPOINT_URL=
MODAL_GROUND_URL=https://inference.us-west.modal.direct
MODAL_FOLD_URL=
# Proxy-auth token pair. The id is wk-..., the secret ws-... — the secret is
# shown once at creation. Keep both out of the repository; on Vercel set them as
# project environment variables.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# json   = POST the task payload as-is (a hand-written Modal web function)
# openai = wrap it as a chat completion (vLLM/SGLang and Auto Endpoints)
# Defaults: ground=openai, fold=json.
MODAL_GROUND_MODE=openai
MODAL_FOLD_MODE=
MODAL_GROUND_MODEL=              # discover with: curl .../v1/models or `modal endpoint list --json`
MODAL_FOLD_MODEL=
MODAL_TIMEOUT_MS=120000

# --- run guards ------------------------------------------------------------
# The two routes that start a review spend Anthropic and Paperclip tokens, and
# they sit on a public URL with no authentication. These bound the exposure.
#
# off = serve cached reviews only. The right setting for a public demo link.
PUBLIC_RUNS=on
# Review starts allowed from one address per window, and the window in ms.
RUN_LIMIT=6
RUN_WINDOW_MS=600000
# Reviews allowed to run at the same time across this instance.
RUN_CONCURRENCY=2

PORT=3000
# Bind address. 0.0.0.0 exposes the app on your network; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Optional: alternate data location. Useful for isolated test runs.
# DATA_DIR=/tmp/fdaapproval-data
# Optional: persist generated reviews/traces somewhere other than DATA_DIR.
# EVALUATIONS_DIR=/var/data/evaluations
# TRACES_DIR=/var/data/traces
